# 依赖包目录
node_modules/

# 打包产物
dist/
build/

# Vite 缓存目录
.vite/

# 环境变量文件（可能包含敏感信息）
.env
.env.*
!.env.example

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript 缓存
*.tsbuildinfo

# IDE 配置
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# 操作系统文件
.DS_Store
Thumbs.db

# 测试覆盖率报告
coverage/
.nyc_output/

# 临时文件
*.tmp
*.cache